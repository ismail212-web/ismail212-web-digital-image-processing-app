# ============================================
# Konfigurasi Digital Image Processing Lab
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================

# Aplikasi
APP_NAME="Digital Image Processing Lab"
APP_VERSION="1.0.0"

# Streamlit Server
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost
STREAMLIT_HEADLESS=true

# Window Desktop
WINDOW_WIDTH=1280
WINDOW_HEIGHT=800
WINDOW_TITLE="DIP Lab - Universitas Nusa Mandiri"

# Fitur
ENABLE_AUTO_UPDATE=false
SHOW_SPLASH=true
ENABLE_DEVTOOLS=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
